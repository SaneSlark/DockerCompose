{
  "version": 8,
  "name": "China Satellite",
  "metadata": {
    "mapbox:autocomposite": false
  },
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "pmtiles://china"
    },
    
    "hefei-satellite": {
      "type": "raster",
      "url": "mbtiles://hefei-satellite"
    },
    
    "sz-satellite": {
      "type": "raster",
      "url": "mbtiles://sz-satellite"
    }
    
  }, 
  
  "glyphs": "{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#2a2a2a"
      }
    },
    
    {
      "id": "satellite-heifei",
      "type": "raster",
      "source": "hefei-satellite",
      "minzoom": 0,
      "maxzoom": 18
    },
    
    {
      "id": "satellite-sz",
      "type": "raster",
      "source": "sz-satellite",
      "minzoom": 0,
      "maxzoom": 18
    },

    {
      "id": "admin-boundaries",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", ["==", "admin_level", 2], ["==", "maritime", 0]],
      "paint": {
        "line-color": "#ffcc00",
        "line-width": {"stops": [[3, 1], [10, 2]]},
        "line-opacity": 0.8
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#000000",
        "line-opacity": 0.5,
        "line-width": ["step", ["zoom"], 0, 12, 2, 18, 12]
      }
    },
    {
      "id": "roads-inner",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "transportation",
      "minzoom": 12,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#ffffff",
        "line-opacity": 0.7,
        "line-width": ["step", ["zoom"], 0, 12, 1, 18, 8]
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "layout": {
        "text-field": "{name:zh}",
        "text-font": ["Noto Sans"],
        "text-size": ["step", ["zoom"], 11, 4, 11, 12, 18],
        "text-max-width": 8,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#ffffff",
        "text-halo-color": "rgba(0,0,0,0.8)",
        "text-halo-width": 2
      }
    },
    {
      "id": "poi-labels",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "poi",
      "minzoom": 14,
      "layout": {
        "text-field": "{name:zh}",
        "text-font": ["Noto Sans Regular"],
        "text-size": 12
      },
      "paint": {
        "text-color": "#51ffff",
        "text-halo-color": "rgba(0,0,0,0.8)",
        "text-halo-width": 1.5
      }
    }
  ]
}